# Required for local live runs. In GitHub, use Actions Secrets instead.
OPENAI_API_KEY=

# Optional model override.
OPENAI_MODEL=gpt-5.6-terra

# Optional Resend email delivery.
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=

# Optional SMTP email delivery (used only when Resend is not configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
