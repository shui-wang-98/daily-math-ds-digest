<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Personalized reports on newly announced arXiv math.DS papers">
  <title>{{ site_title }}</title>
  <link rel="stylesheet" href="assets/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to reports</a>
  <header class="site-header">
    <div class="container header-inner">
      <span class="site-name">arXiv · Dynamical Systems</span>
      <span class="subtitle">Personal research archive</span>
    </div>
  </header>

  <main id="main" class="container home">
    <header class="home-intro">
      <h1>{{ site_title }}</h1>
      <p>Daily reports on newly announced and newly cross-listed arXiv papers in math.DS, classified according to a personalized research profile.</p>
      <p class="reading-note">Choose a date to read the full report online. Historical PDF and Markdown downloads are linked where available.</p>
    </header>

    <section class="archive" aria-labelledby="archive-heading">
      <h2 id="archive-heading">Report archive</h2>
      {% if reports %}
      <p class="section-note">Newest first · {{ reports | length }} report{{ '' if reports | length == 1 else 's' }}</p>
      <ol class="archive-list">
        {% for item in reports %}
        <li class="archive-row">
          <div class="archive-heading">
            <h3><a class="archive-date" href="reports/{{ item.report_date }}/"><time datetime="{{ item.report_date }}">{{ item.report_date }}</time></a></h3>
            {% if loop.first %}<span class="latest-label">Latest report</span>{% endif %}
            <a class="open-report" href="reports/{{ item.report_date }}/" aria-label="Open report for {{ item.report_date }}">Open report <span aria-hidden="true">→</span></a>
          </div>
          <dl class="report-counts">
            <div><dt>HIGH PRIORITY</dt><dd>{{ item.counts.get('HIGH PRIORITY', 0) }}</dd></div>
            <div><dt>RELATED / POSSIBLY INTERESTING</dt><dd>{{ item.counts.get('RELATED / POSSIBLY INTERESTING', 0) }}</dd></div>
            <div><dt>LOW PRIORITY</dt><dd>{{ item.counts.get('LOW PRIORITY', 0) }}</dd></div>
            <div><dt>TOTAL PAPERS</dt><dd>{{ item.total }}</dd></div>
          </dl>
          {% if item.total == 0 %}<p class="no-papers">No new papers.</p>{% endif %}
          {% if item.legacy_downloads %}
          <p class="archive-downloads"><span>Historical downloads:</span>{% for download in item.legacy_downloads %} <a href="reports/{{ item.report_date }}/{{ download.href }}" title="{{ download.filename }}">{{ download.label }}</a>{% endfor %}</p>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
      {% else %}
      <p class="empty-archive">No reports have been generated yet.</p>
      {% endif %}
    </section>
  </main>

  <footer class="site-footer"><div class="container">Source: official arXiv math.DS RSS feed. Classification reflects research relevance.</div></footer>
</body>
</html>
