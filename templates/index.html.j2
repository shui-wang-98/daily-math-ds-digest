<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Personalized arXiv reports for Dynamical Systems">
  <title>{{ site_title }}</title>
  <link rel="stylesheet" href="assets/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <span class="site-name">{{ site_title }}</span>
      <span class="subtitle">{{ subtitle }}</span>
    </div>
  </header>

  <main class="container home">
    <section class="home-hero">
      <p class="eyebrow">Personal research feed · arXiv math.DS</p>
      <h1>Daily Dynamical Systems Reports</h1>
      <p>Weekday reports classified for entropy, thermodynamic formalism, mean dimension, fractal geometry, topological and symbolic dynamics, and group actions.</p>
    </section>

    {% if latest %}
    <section class="latest-card">
      <p class="eyebrow">Latest report</p>
      <h2><a href="reports/{{ latest.report_date }}/">{{ latest.report_date }}</a></h2>
      <div class="count-row">
        <span class="count high"><strong>{{ latest.counts['HIGH PRIORITY'] }}</strong> high</span>
        <span class="count related"><strong>{{ latest.counts['RELATED / POSSIBLY INTERESTING'] }}</strong> related</span>
        <span class="count low"><strong>{{ latest.counts['LOW PRIORITY'] }}</strong> low</span>
      </div>
      <p>{{ latest.overview }}</p>
      <p class="paper-links">
        <a href="reports/{{ latest.report_date }}/">Read report</a>
        <a href="reports/{{ latest.report_date }}/{{ latest.pdf_filename }}">Download PDF</a>
      </p>
    </section>
    {% else %}
    <section class="latest-card"><p>No report has been generated yet.</p></section>
    {% endif %}

    <section class="archive">
      <h2>Archive</h2>
      {% if reports %}
      <div class="archive-table" role="table">
        {% for item in reports %}
        <div class="archive-row" role="row">
          <a role="cell" class="archive-date" href="reports/{{ item.report_date }}/">{{ item.report_date }}</a>
          <span role="cell">{{ item.counts['HIGH PRIORITY'] }} high · {{ item.counts['RELATED / POSSIBLY INTERESTING'] }} related · {{ item.counts['LOW PRIORITY'] }} low</span>
          <span role="cell" class="archive-links"><a href="reports/{{ item.report_date }}/{{ item.pdf_filename }}">PDF</a> <a href="reports/{{ item.report_date }}/{{ item.markdown_filename }}">MD</a></span>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p>No reports yet.</p>
      {% endif %}
    </section>
  </main>

  <footer class="site-footer"><div class="container">Generated automatically from the official arXiv math.DS RSS feed.</div></footer>
</body>
</html>
